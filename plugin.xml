<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <class>ru.krimm.openfire.mobileaccess.MobileAccessPlugin</class>
    <name>Mobile Access</name>
    <description>Provides separate local mobile credentials for LDAP-backed Openfire users while preserving Kerberos SSO for domain Windows clients.</description>
    <author>s-kholman</author>
    <version>${project.version}</version>
    <date>2026-07-18</date>
    <url>https://github.com/s-kholman/openfire-mobile-access</url>
    <minServerVersion>5.1.1</minServerVersion>
    <minJavaVersion>17</minJavaVersion>
    <licenseType>apache</licenseType>
    <databaseKey>mobileaccess</databaseKey>
    <databaseVersion>1</databaseVersion>
    <csrfProtectionEnabled>true</csrfProtectionEnabled>
    <adminconsole>
        <tab id="server" name="Server" url="mobileaccess-admin.jsp" description="Openfire server administration">
            <sidebar id="server-settings" name="Server Settings">
                <item id="mobileaccess-admin" name="Mobile Access"
                      url="mobileaccess-admin.jsp"
                      description="Issue or revoke local mobile credentials"
                      order="90" />
            </sidebar>
        </tab>
    </adminconsole>
</plugin>
